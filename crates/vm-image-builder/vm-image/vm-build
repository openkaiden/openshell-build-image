# Entry point of the build microVM, exec'd by the vm-image-builder crate.
#
# Usage: vm-build <containerfile-vm-path> <tag> <output-filename>
#   containerfile-vm-path  path to the Containerfile as seen inside the VM
#   tag                    image tag for buildah
#   output-filename        name of the rootfs tarball written to /build/output/
set -e

CFILE="$1"
TAG="$2"
OUTPUT_FILE="$3"

on_exit() {
    rc=$?
    if [ "$rc" -ne 0 ]; then
        oom=$(dmesg 2>/dev/null | grep -iE 'oom|killed process|out of memory' | tail -5)
        if [ -n "$oom" ]; then
            printf '\n[vm-build] OOM detected:\n%s\n' "$oom" >&2
            printf '[vm-build] Hint: retry with a larger --vm-memory value\n' >&2
        fi
    fi
}
trap on_exit EXIT

mkdir -p /build/context /build/output
mount -t virtiofs openshell-context /build/context
mount -t virtiofs openshell-output  /build/output

# virtiofs on APFS does not fully support xattrs: lgetxattr on dangling symlinks
# returns ENOENT, which breaks buildah's VFS layer copy. Mount tmpfs over the
# buildah storage root so xattr operations happen on a native Linux filesystem.
#
# The size limit must accommodate pulled base image layers (VFS stores full
# copies, so a typical Fedora build needs 2-4 GB), but tmpfs pages come out of
# guest RAM: a ceiling above the VM's memory just moves the failure from a clean
# ENOSPC to an OOM kill. Derive it from the VM's actual memory instead of the
# kernel default (50% of RAM), leaving a quarter for buildah and the kernel.
MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
STORAGE_MB=$((MEM_KB * 3 / 4 / 1024))
mkdir -p /var/lib/containers
mount -t tmpfs -o size="${STORAGE_MB}m" tmpfs /var/lib/containers

# /run is on the virtiofs-mounted rootfs, which persists between runs and is
# shared by concurrent builds. Give each run its own, so buildah's lock files
# and the resolv.conf below stay out of it.
mount -t tmpfs tmpfs /run
mkdir -p /run/containers

# The host passes its own nameservers here, since no fixed address works
# everywhere. Empty is fine: the rootfs ships a public resolver as a fallback.
# Bind-mounted rather than written, because /etc is on the shared rootfs.
if [ -n "$OPENSHELL_VM_DNS" ]; then
    for ns in $OPENSHELL_VM_DNS; do
        echo "nameserver $ns"
    done > /run/resolv.conf
    mount -o bind /run/resolv.conf /etc/resolv.conf
fi

# buildah uses /var/tmp for temporary blob files during image pulls.
# Keeping this on the virtiofs-mounted rootfs opens a host-side fd for
# every file, exhausting the host process's fd limit. Use tmpfs instead.
mkdir -p /var/tmp
mount -t tmpfs tmpfs /var/tmp

# Pulling images with many layers opens a lock file per layer concurrently.
# Alpine's default soft limit (1024) is too low; raise it to the hard limit.
ulimit -n "$(ulimit -Hn)"

buildah bud --isolation chroot --network host -f "$CFILE" -t "$TAG" /build/context

# The VM has no access to the host's image store, so the built image is
# flattened into a tarball handed back through the output share.
ctr=$(buildah from "$TAG")
mnt=$(buildah mount "$ctr")
tar -cf /build/output/"$OUTPUT_FILE" -C "$mnt" .
buildah umount "$ctr"
buildah rm "$ctr"
